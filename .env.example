# Copy this file to .env.local and paste your real key after the = sign.
# .env.local is ignored by git, so your key never gets uploaded.
# Leave it empty to run in demo mode (sample answers, no AI calls).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use. Leave empty for the default (gemini-3.8-flash).
GEMINI_MODEL=
