# Copy this file to .env.local and paste your real key after the = sign.
# .env.local is ignored by git, so your key never gets uploaded.
# Leave it empty to run in demo mode (sample answers, no AI calls).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: which AI model to use. Leave empty for the default (google/gemini-3.5-flash-lite).
# Must accept images. Other options: google/gemini-3.8-flash (slower), anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=
